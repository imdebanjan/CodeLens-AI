# CodeLens AI Backend Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# AI Engine (Google Gemini API Key - Optional: uses built-in heuristic engine if blank)
GEMINI_API_KEY=

# Database (MongoDB URI - Optional: uses built-in in-memory store if offline)
MONGODB_URI=mongodb://127.0.0.1:27017/codelens

# JWT Authentication
JWT_SECRET=codelens-super-secret-key-development-32bytes
JWT_EXPIRES_IN=7d

# Limits
MAX_CODE_CHARS=30000
